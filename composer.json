{
  "name": "tamara-solution/php-sdk",
  "license": "MIT",
  "description": "Tamara PHP Client Library",
  "version": "3.0.1",
  "keywords": [
    "tamara",
    "tamara php sdk",
    "buy now pay later",
    "installment"
  ],
  "homepage": "https://github.com/tamara-solution/php-sdk",
  "authors": [
    {
      "name": "Tamara Team",
      "email": "tech@tamara.co"
    }
  ],
  "require": {
    "php": ">=8.1",
    "psr/http-client": "^1.0",
    "psr/log": "^3.0.0",
    "ext-json": "*",
    "symfony/http-foundation": "^6.4",
    "firebase/php-jwt": "^7.0",
    "nyholm/psr7": "^1.3",
    "kriswallsmith/buzz": "^1.2|^0.16",
    "guzzlehttp/guzzle": ">=6.0"
  },
  "require-dev": {
    "phpunit/phpunit": ">=7",
    "phpstan/phpstan": "^2.1",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Tamara\\": "src/Tamara"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tamara\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse",
    "install-hooks": "@php scripts/install-hooks.php",
    "post-install-cmd": "@install-hooks",
    "post-update-cmd": "@install-hooks"
  }
}
